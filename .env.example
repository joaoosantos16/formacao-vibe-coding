# Copia este ficheiro para .env.local e preenche com os valores reais.
# NUNCA commites um ficheiro .env ou .env.local com valores reais.

# Supabase — em supabase.com > o teu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A "service_role key" do Supabase NUNCA deve estar aqui nem em código que
# corre no browser. Só seria usada em código de servidor (API routes), e
# mesmo assim só se for mesmo necessário.
